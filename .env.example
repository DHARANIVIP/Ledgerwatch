# LedgerWatch Environment Variables Configuration

# Server Port (auto-assigned by cloud hosts such as Render, Railway, Heroku)
PORT=8000

# Google Gemini API Key (Optional)
# If provided, Gemini 2.5 Flash narrates the deterministic anomaly findings.
# If omitted, LedgerWatch automatically falls back to deterministic expert narration.
GEMINI_API_KEY=

# Allowed CORS Origins (comma-separated, e.g. https://yourdomain.com,http://localhost:5173)
# Leave empty or set to * to allow all origins
ALLOWED_ORIGINS=*
